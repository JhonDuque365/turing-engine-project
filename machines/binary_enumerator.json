{
  "name": "binary_enumerator",
  "mode": "enumerator",
  "description": "Enumerador de cadenas binarias en orden canónico: ε, 0, 1, 00, 01, 10, 11, ... Este modo genera cadenas; no decide pertenencia a un lenguaje.",
  "states": ["q0", "qaccept", "qreject"],
  "input_alphabet": ["0", "1"],
  "tape_alphabet": ["0", "1", "_"],
  "blank": "_",
  "start": "q0",
  "accept": "qaccept",
  "reject": "qreject",
  "transitions": [
    {"from": "q0", "read": "0", "to": "qaccept", "write": "0", "move": "S"},
    {"from": "q0", "read": "1", "to": "qaccept", "write": "1", "move": "S"},
    {"from": "q0", "read": "_", "to": "qaccept", "write": "_", "move": "S"}
  ],
  "tests": [
    {"input": "",   "expected": "accept"},
    {"input": "0",  "expected": "accept"},
    {"input": "1",  "expected": "accept"},
    {"input": "00", "expected": "accept"},
    {"input": "11", "expected": "accept"}
  ]
}
