{
  "name": "palindrome_decider",
  "mode": "decider",
  "description": "Decide PAL = { w | w = w^R } sobre {0,1}. Marca y compara extremos iterativamente.",
  "states": [
    "q0",
    "q_seek0", "q_seek1",
    "q_found0", "q_found1",
    "q_back",
    "q_check",
    "qaccept", "qreject"
  ],
  "input_alphabet": ["0", "1"],
  "tape_alphabet": ["0", "1", "X", "_"],
  "blank": "_",
  "start": "q0",
  "accept": "qaccept",
  "reject": "qreject",
  "transitions": [
    {"from": "q0",       "read": "_", "to": "qaccept",  "write": "_", "move": "S"},
    {"from": "q0",       "read": "X", "to": "q_check",  "write": "X", "move": "R"},
    {"from": "q0",       "read": "0", "to": "q_seek0",  "write": "X", "move": "R"},
    {"from": "q0",       "read": "1", "to": "q_seek1",  "write": "X", "move": "R"},
    {"from": "q_seek0",  "read": "0", "to": "q_seek0",  "write": "0", "move": "R"},
    {"from": "q_seek0",  "read": "1", "to": "q_seek0",  "write": "1", "move": "R"},
    {"from": "q_seek0",  "read": "X", "to": "q_seek0",  "write": "X", "move": "R"},
    {"from": "q_seek0",  "read": "_", "to": "q_found0", "write": "_", "move": "L"},
    {"from": "q_seek1",  "read": "0", "to": "q_seek1",  "write": "0", "move": "R"},
    {"from": "q_seek1",  "read": "1", "to": "q_seek1",  "write": "1", "move": "R"},
    {"from": "q_seek1",  "read": "X", "to": "q_seek1",  "write": "X", "move": "R"},
    {"from": "q_seek1",  "read": "_", "to": "q_found1", "write": "_", "move": "L"},
    {"from": "q_found0", "read": "X", "to": "q_found0", "write": "X", "move": "L"},
    {"from": "q_found0", "read": "_", "to": "qaccept",  "write": "_", "move": "S"},
    {"from": "q_found0", "read": "0", "to": "q_back",   "write": "X", "move": "L"},
    {"from": "q_found0", "read": "1", "to": "qreject",  "write": "1", "move": "S"},
    {"from": "q_found1", "read": "X", "to": "q_found1", "write": "X", "move": "L"},
    {"from": "q_found1", "read": "_", "to": "qaccept",  "write": "_", "move": "S"},
    {"from": "q_found1", "read": "1", "to": "q_back",   "write": "X", "move": "L"},
    {"from": "q_found1", "read": "0", "to": "qreject",  "write": "0", "move": "S"},
    {"from": "q_back",   "read": "0", "to": "q_back",   "write": "0", "move": "L"},
    {"from": "q_back",   "read": "1", "to": "q_back",   "write": "1", "move": "L"},
    {"from": "q_back",   "read": "X", "to": "q_back",   "write": "X", "move": "L"},
    {"from": "q_back",   "read": "_", "to": "q0",       "write": "_", "move": "R"},
    {"from": "q_check",  "read": "X", "to": "q_check",  "write": "X", "move": "R"},
    {"from": "q_check",  "read": "_", "to": "qaccept",  "write": "_", "move": "S"}
  ],
  "tests": [
    {"input": "",   "expected": "accept"},
    {"input": "11", "expected": "accept"},
    {"input": "00", "expected": "accept"},
    {"input": "01", "expected": "reject"},
    {"input": "10", "expected": "reject"}
  ]
}
