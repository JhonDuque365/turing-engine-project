{
  "name": "anbn_decider",
  "mode": "decider",
  "description": "Decide L = { a^n b^n | n >= 0 } marcando pares a/b iterativamente. Algoritmo: busca la primera 'a' sin marcar, la reemplaza por X, avanza hasta la primera 'b' sin marcar, la reemplaza por Y, regresa al inicio y repite. Acepta si al final no quedan simbolos sin marcar.",
  "states": ["q0", "q1", "q2", "q3", "qaccept", "qreject"],
  "input_alphabet": ["a", "b"],
  "tape_alphabet": ["a", "b", "X", "Y", "_"],
  "blank": "_",
  "start": "q0",
  "accept": "qaccept",
  "reject": "qreject",
  "transitions": [
    {"from": "q0", "read": "X", "to": "q0",      "write": "X", "move": "R"},
    {"from": "q0", "read": "Y", "to": "q3",      "write": "Y", "move": "R"},
    {"from": "q0", "read": "a", "to": "q1",      "write": "X", "move": "R"},
    {"from": "q0", "read": "b", "to": "qreject", "write": "b", "move": "S"},
    {"from": "q0", "read": "_", "to": "qaccept", "write": "_", "move": "S"},

    {"from": "q1", "read": "a", "to": "q1",      "write": "a", "move": "R"},
    {"from": "q1", "read": "X", "to": "q1",      "write": "X", "move": "R"},
    {"from": "q1", "read": "Y", "to": "q1",      "write": "Y", "move": "R"},
    {"from": "q1", "read": "b", "to": "q2",      "write": "Y", "move": "L"},
    {"from": "q1", "read": "_", "to": "qreject", "write": "_", "move": "S"},

    {"from": "q2", "read": "a", "to": "q2",      "write": "a", "move": "L"},
    {"from": "q2", "read": "b", "to": "q2",      "write": "b", "move": "L"},
    {"from": "q2", "read": "X", "to": "q2",      "write": "X", "move": "L"},
    {"from": "q2", "read": "Y", "to": "q2",      "write": "Y", "move": "L"},
    {"from": "q2", "read": "_", "to": "q0",      "write": "_", "move": "R"},

    {"from": "q3", "read": "Y", "to": "q3",      "write": "Y", "move": "R"},
    {"from": "q3", "read": "b", "to": "qreject", "write": "b", "move": "S"},
    {"from": "q3", "read": "_", "to": "qaccept", "write": "_", "move": "S"}
  ],
  "tests": [
    {"input": "",        "expected": "accept"},
    {"input": "ab",      "expected": "accept"},
    {"input": "aabb",    "expected": "accept"},
    {"input": "aaabbb",  "expected": "accept"},
    {"input": "aaaabbbb","expected": "accept"},
    {"input": "a",       "expected": "reject"},
    {"input": "b",       "expected": "reject"},
    {"input": "aab",     "expected": "reject"},
    {"input": "abb",     "expected": "reject"},
    {"input": "abab",    "expected": "reject"},
    {"input": "ba",      "expected": "reject"},
    {"input": "bbaa",    "expected": "reject"}
  ]
}
